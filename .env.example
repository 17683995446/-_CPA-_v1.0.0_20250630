# ========== CPA Learning App 环境变量 ==========

# --- 应用基础 ---
# 调试模式（开发环境设为 true，生产环境必须为 false）
DEBUG=false

# --- 数据库 ---
# SQLite 文件路径（默认存放在 backend/data/ 目录下）
# 生产环境可改为 PostgreSQL: postgresql://user:pass@localhost:5432/cpa_learning
DATABASE_URL=sqlite:///data/cpa_learning.db

# --- 题库 ---
# 启动时是否自动初始化种子数据与题库（Docker 构建时已预生成，设为 false）
AUTO_SEED_ON_STARTUP=true

# 题库不足此数时触发批量生成
QUESTION_BANK_THRESHOLD=5000

# --- 日志 ---
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- 游戏化参数（可选，以下为默认值）---
# 答对一题获得的基础 XP
# XP_PER_CORRECT=10
# 连续学习每天额外 XP
# XP_PER_STREAK_DAY=5
# 暴击触发概率 (0.0-1.0)
# GAMIFICATION_CRITICAL_CHANCE=0.1
# 暴击 XP 倍数
# GAMIFICATION_CRITICAL_MULTIPLIER=3.0
# 1级升2级所需 XP
# GAMIFICATION_BASE_LEVEL_XP=100
# 每级 XP 需求增长率
# GAMIFICATION_LEVEL_GROWTH_RATE=1.5

# --- 时区 ---
TZ=Asia/Shanghai
